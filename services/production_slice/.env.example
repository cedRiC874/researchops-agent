RESEARCHOPS_ENVIRONMENT=development
RESEARCHOPS_DATABASE_HOST=postgres
RESEARCHOPS_DATABASE_PORT=5432
RESEARCHOPS_DATABASE_NAME=researchops
RESEARCHOPS_DATABASE_USER=researchops
RESEARCHOPS_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
RESEARCHOPS_OBJECT_ENDPOINT=http://minio:9000
RESEARCHOPS_OBJECT_REGION=us-east-1
RESEARCHOPS_OBJECT_BUCKET=researchops-artifacts
RESEARCHOPS_OBJECT_SERVER_SIDE_ENCRYPTION=false
RESEARCHOPS_OBJECT_ACCESS_KEY_FILE=/run/secrets/minio_access_key
RESEARCHOPS_OBJECT_SECRET_KEY_FILE=/run/secrets/minio_secret_key
RESEARCHOPS_API_TOKEN_FILE=/run/secrets/api_token
RESEARCHOPS_IDEMPOTENCY_HMAC_KEY_FILE=/run/secrets/idempotency_hmac_key
RESEARCHOPS_REGISTRY_PATH=/data/logical_dataset_registry.json
RESEARCHOPS_OTLP_HTTP_ENDPOINT=http://otel-collector:4318/v1/traces
RESEARCHOPS_WORKER_POLL_SECONDS=1.0
RESEARCHOPS_WORKER_LEASE_SECONDS=60
RESEARCHOPS_WORKER_MAX_ATTEMPTS=3
