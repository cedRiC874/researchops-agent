{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/provider-completion-external-ledger-entry-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "entry_type",
    "ledger_id",
    "sequence",
    "previous_head_sha256",
    "occurred_at_utc",
    "candidate_freeze_receipt_sha256",
    "preregistration_envelope_sha256",
    "authorization_grant_sha256",
    "consumption_receipt_sha256",
    "closure_receipt_sha256",
    "entry_sha256",
    "resulting_head_sha256",
    "signatures"
  ],
  "properties": {
    "schema_version": {"const": "provider-completion-external-ledger-entry/1.0"},
    "document_type": {"const": "completion_telemetry_external_ledger_entry"},
    "entry_type": {
      "enum": ["candidate_frozen", "preregistration_frozen", "authorization_consumed", "closure_evidence_anchored"]
    },
    "ledger_id": {"type": "string", "pattern": "^PCELEDGER-[A-F0-9]{32}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previous_head_sha256": {"$ref": "#/$defs/sha256"},
    "occurred_at_utc": {"$ref": "#/$defs/timestamp"},
    "candidate_freeze_receipt_sha256": {
      "oneOf": [{"$ref": "#/$defs/nonzero_sha256"}, {"type": "null"}]
    },
    "preregistration_envelope_sha256": {
      "oneOf": [{"$ref": "#/$defs/nonzero_sha256"}, {"type": "null"}]
    },
    "authorization_grant_sha256": {
      "oneOf": [{"$ref": "#/$defs/nonzero_sha256"}, {"type": "null"}]
    },
    "consumption_receipt_sha256": {
      "oneOf": [{"$ref": "#/$defs/nonzero_sha256"}, {"type": "null"}]
    },
    "closure_receipt_sha256": {
      "oneOf": [{"$ref": "#/$defs/nonzero_sha256"}, {"type": "null"}]
    },
    "entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "resulting_head_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"entry_type": {"const": "candidate_frozen"}}, "required": ["entry_type"]},
      "then": {
        "properties": {
          "candidate_freeze_receipt_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "preregistration_envelope_sha256": {"type": "null"},
          "authorization_grant_sha256": {"type": "null"},
          "consumption_receipt_sha256": {"type": "null"},
          "closure_receipt_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"entry_type": {"const": "preregistration_frozen"}}, "required": ["entry_type"]},
      "then": {
        "properties": {
          "candidate_freeze_receipt_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "preregistration_envelope_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "authorization_grant_sha256": {"type": "null"},
          "consumption_receipt_sha256": {"type": "null"},
          "closure_receipt_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"entry_type": {"const": "authorization_consumed"}}, "required": ["entry_type"]},
      "then": {
        "properties": {
          "candidate_freeze_receipt_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "preregistration_envelope_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "authorization_grant_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "consumption_receipt_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "closure_receipt_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"entry_type": {"const": "closure_evidence_anchored"}}, "required": ["entry_type"]},
      "then": {
        "properties": {
          "candidate_freeze_receipt_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "preregistration_envelope_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "authorization_grant_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "consumption_receipt_sha256": {"$ref": "#/$defs/nonzero_sha256"},
          "closure_receipt_sha256": {"$ref": "#/$defs/nonzero_sha256"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzero_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "key_id": {"type": "string", "pattern": "^PCEKEY-[A-F0-9]{32}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "key_id", "algorithm", "signed_sha256", "signature_b64"],
      "properties": {
        "role": {"const": "ledger_witness"},
        "key_id": {"$ref": "#/$defs/key_id"},
        "algorithm": {"const": "ed25519"},
        "signed_sha256": {"$ref": "#/$defs/sha256"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
