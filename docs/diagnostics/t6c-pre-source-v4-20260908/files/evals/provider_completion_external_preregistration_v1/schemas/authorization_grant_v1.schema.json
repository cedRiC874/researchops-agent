{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/provider-completion-external-authorization-grant-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "grant_id",
    "authorized_at_utc",
    "not_before_utc",
    "expires_at_utc",
    "explicit_user_authorization_id_sha256",
    "explicit_user_authorization_binding_sha256",
    "preregistration_envelope_sha256",
    "preregistration_freeze_entry_sha256",
    "ledger_sequence",
    "ledger_head_sha256",
    "candidate_commit",
    "candidate_tree",
    "source_integrity_commitment_sha256",
    "runtime_registry_commitment_sha256",
    "denominator_plan_commitment_sha256",
    "external_plan_binding_sha256",
    "budget_policy_commitment_sha256",
    "pricing_snapshot_date",
    "pricing_source_snapshot_sha256",
    "pricing_retrieved_at_utc",
    "official_pricing_attestation_current",
    "provider_id",
    "model_id",
    "api_origin",
    "api_surface",
    "transport_id",
    "single_use",
    "consume_before_task_release_and_key_load",
    "agents_sdk_retries",
    "http_client_retries",
    "resume",
    "fallback",
    "status",
    "closure_claim_allowed_by_grant",
    "provider_registration_allowed",
    "model_quality_claim_allowed",
    "document_sha256",
    "signatures"
  ],
  "properties": {
    "schema_version": {"const": "provider-completion-external-authorization-grant/1.0"},
    "document_type": {"const": "completion_telemetry_closure_authorization_grant"},
    "grant_id": {"type": "string", "pattern": "^PCEGRANT-[A-F0-9]{32}$"},
    "authorized_at_utc": {"$ref": "#/$defs/timestamp"},
    "not_before_utc": {"$ref": "#/$defs/timestamp"},
    "expires_at_utc": {"$ref": "#/$defs/timestamp"},
    "explicit_user_authorization_id_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "explicit_user_authorization_binding_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "preregistration_envelope_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "preregistration_freeze_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "ledger_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "ledger_head_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "candidate_commit": {"$ref": "#/$defs/git_sha"},
    "candidate_tree": {"$ref": "#/$defs/git_sha"},
    "source_integrity_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "runtime_registry_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "denominator_plan_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "external_plan_binding_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "budget_policy_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "pricing_snapshot_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "pricing_source_snapshot_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "pricing_retrieved_at_utc": {"$ref": "#/$defs/timestamp"},
    "official_pricing_attestation_current": {"const": true},
    "provider_id": {"const": "deepseek"},
    "model_id": {"const": "deepseek-v4-flash"},
    "api_origin": {"const": "https://api.deepseek.com"},
    "api_surface": {"const": "responses"},
    "transport_id": {"const": "openai_compatible_responses"},
    "single_use": {"const": true},
    "consume_before_task_release_and_key_load": {"const": true},
    "agents_sdk_retries": {"const": 0},
    "http_client_retries": {"const": 0},
    "resume": {"const": false},
    "fallback": {"const": false},
    "status": {"const": "authorized"},
    "closure_claim_allowed_by_grant": {"const": false},
    "provider_registration_allowed": {"const": false},
    "model_quality_claim_allowed": {"const": false},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "signatures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/signature"}, {"properties": {"role": {"const": "freeze_authority"}}}]},
        {"allOf": [{"$ref": "#/$defs/signature"}, {"properties": {"role": {"const": "task_custodian"}}}]}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzero_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "key_id": {"type": "string", "pattern": "^PCEKEY-[A-F0-9]{32}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "key_id", "algorithm", "signed_sha256", "signature_b64"],
      "properties": {
        "role": {"enum": ["freeze_authority", "task_custodian"]},
        "key_id": {"$ref": "#/$defs/key_id"},
        "algorithm": {"const": "ed25519"},
        "signed_sha256": {"$ref": "#/$defs/sha256"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
