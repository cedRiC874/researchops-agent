{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/completion_timing_evidence_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "timing_contract_sha256",
    "plan_commitment_sha256",
    "binding",
    "execution_binding_sha256",
    "clock_domain_id",
    "clock_source",
    "clock_unit",
    "origin_offset_ns",
    "record_provenance",
    "segments",
    "phase",
    "audit_chain_heads_sha256",
    "evidence_commitment_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "provider-completion-timing-evidence/1.0"
    },
    "document_type": {
      "const": "completion_timing_evidence"
    },
    "timing_contract_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "plan_commitment_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "execution_commit",
        "execution_tree",
        "source_integrity_commitment_sha256",
        "runtime_plan_core_sha256",
        "provider_id",
        "api_surface",
        "transport_id",
        "adapter_version",
        "authorization_grant_sha256",
        "external_consumption_anchor_sha256",
        "runtime_plan_commitment_sha256"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "pattern": "^PCECAMP-[A-F0-9]{32}$",
          "maxLength": 40
        },
        "execution_commit": {
          "type": "string",
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
          "minLength": 40,
          "maxLength": 40
        },
        "execution_tree": {
          "type": "string",
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
          "minLength": 40,
          "maxLength": 40
        },
        "source_integrity_commitment_sha256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "runtime_plan_core_sha256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "provider_id": {
          "const": "deepseek"
        },
        "api_surface": {
          "const": "responses"
        },
        "transport_id": {
          "const": "openai_compatible_responses"
        },
        "adapter_version": {
          "const": "deepseek-responses-adapter/1.0"
        },
        "authorization_grant_sha256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "external_consumption_anchor_sha256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "runtime_plan_commitment_sha256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "execution_binding_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "clock_domain_id": {
      "type": "string",
      "pattern": "^PCECLOCK-[A-F0-9]{32}$",
      "maxLength": 41
    },
    "clock_source": {
      "const": "time.monotonic_ns"
    },
    "clock_unit": {
      "const": "relative_integer_nanoseconds"
    },
    "origin_offset_ns": {
      "const": 0
    },
    "record_provenance": {
      "enum": [
        "live_monotonic_capture",
        "synthetic_fixture",
        "not_persisted"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 800,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "document_type",
          "plan_commitment_sha256",
          "execution_binding_sha256",
          "clock_domain_id",
          "case_handle",
          "attempt_index",
          "case_attempt_index",
          "request_index",
          "response_index",
          "terminal_kind",
          "attempt_started_ns",
          "send_started_ns",
          "transport_terminal_ns",
          "raw_cleanup_terminal_ns",
          "raw_cleanup_status",
          "lifetime_ended_ns",
          "completion_record_sha256",
          "usage_sha256",
          "segment_commitment_sha256"
        ],
        "properties": {
          "schema_version": {
            "const": "provider-completion-timing-segment/1.0"
          },
          "document_type": {
            "const": "completion_timing_segment"
          },
          "plan_commitment_sha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "execution_binding_sha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "clock_domain_id": {
            "type": "string",
            "pattern": "^PCECLOCK-[A-F0-9]{32}$",
            "maxLength": 41
          },
          "case_handle": {
            "type": "string",
            "pattern": "^PCECASE-[A-F0-9]{32}$",
            "maxLength": 40
          },
          "attempt_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 799
          },
          "case_attempt_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "request_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 799
          },
          "response_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 799
              },
              {
                "type": "null"
              }
            ]
          },
          "terminal_kind": {
            "enum": [
              "response_accepted",
              "response_rejected",
              "http_error",
              "no_response",
              "cancelled",
              "outcome_unknown"
            ]
          },
          "attempt_started_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "send_started_ns": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "transport_terminal_ns": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "raw_cleanup_terminal_ns": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "raw_cleanup_status": {
            "enum": [
              "completed",
              "not_applicable",
              "failed",
              "timed_out",
              "cancelled",
              "unknown"
            ]
          },
          "lifetime_ended_ns": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "completion_record_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "usage_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "segment_commitment_sha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_released_ns",
        "key_loaded_ns",
        "post_cleanup_terminal_ns",
        "post_cleanup_status",
        "key_reference_released_ns",
        "key_reference_release_status",
        "phase_terminal_ns"
      ],
      "properties": {
        "task_released_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "key_loaded_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "post_cleanup_terminal_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "post_cleanup_status": {
          "enum": [
            "completed",
            "not_applicable",
            "failed",
            "timed_out",
            "cancelled",
            "unknown"
          ]
        },
        "key_reference_released_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "key_reference_release_status": {
          "enum": [
            "released",
            "not_loaded",
            "failed",
            "timed_out",
            "cancelled",
            "unknown"
          ]
        },
        "phase_terminal_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "audit_chain_heads_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "evidence_commitment_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
