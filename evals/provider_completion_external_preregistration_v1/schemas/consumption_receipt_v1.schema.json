{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/provider-completion-external-consumption-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "receipt_id",
    "consumed_at_utc",
    "preregistration_envelope_sha256",
    "preregistration_freeze_entry_sha256",
    "authorization_grant_sha256",
    "explicit_user_authorization_id_sha256",
    "candidate_commit",
    "denominator_plan_commitment_sha256",
    "external_plan_binding_sha256",
    "task_released_at_consumption",
    "provider_key_loaded_at_consumption",
    "external_consumption_ledger_entry_required_before_task_release_or_key_load",
    "network_attempts_at_consumption",
    "model_requests_at_consumption",
    "single_use_consumed",
    "retry_authorized",
    "resume_authorized",
    "status",
    "provider_key_persisted",
    "task_content_persisted",
    "document_sha256"
  ],
  "properties": {
    "schema_version": {"const": "provider-completion-external-consumption-receipt/1.0"},
    "document_type": {"const": "completion_telemetry_closure_consumption_receipt"},
    "receipt_id": {"type": "string", "pattern": "^PCECONSUME-[A-F0-9]{32}$"},
    "consumed_at_utc": {"$ref": "#/$defs/timestamp"},
    "preregistration_envelope_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "preregistration_freeze_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "authorization_grant_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "explicit_user_authorization_id_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "candidate_commit": {"$ref": "#/$defs/git_sha"},
    "denominator_plan_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "external_plan_binding_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "task_released_at_consumption": {"const": false},
    "provider_key_loaded_at_consumption": {"const": false},
    "external_consumption_ledger_entry_required_before_task_release_or_key_load": {"const": true},
    "network_attempts_at_consumption": {"const": 0},
    "model_requests_at_consumption": {"const": 0},
    "single_use_consumed": {"const": true},
    "retry_authorized": {"const": false},
    "resume_authorized": {"const": false},
    "status": {"const": "consumed"},
    "provider_key_persisted": {"const": false},
    "task_content_persisted": {"const": false},
    "document_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzero_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
