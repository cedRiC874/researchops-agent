{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/provider-completion-closure-run-event-projection-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_type", "actor_kind", "safe_payload"],
  "properties": {
    "schema_version": {"const": "provider-completion-closure-run-event-projection/1.0"},
    "event_type": {
      "enum": ["run_started", "model_call_recorded", "model_run_usage_recorded", "run_status_changed"]
    },
    "actor_kind": {"enum": ["system", "agent_sdk"]},
    "safe_payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "run_started"}}, "required": ["event_type"]},
      "then": {
        "properties": {
          "actor_kind": {"const": "system"},
          "safe_payload": {"$ref": "#/$defs/run_started"}
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "model_call_recorded"}}, "required": ["event_type"]},
      "then": {
        "properties": {
          "actor_kind": {"const": "agent_sdk"},
          "safe_payload": {"$ref": "#/$defs/model_call_recorded"}
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "model_run_usage_recorded"}}, "required": ["event_type"]},
      "then": {
        "properties": {
          "actor_kind": {"const": "agent_sdk"},
          "safe_payload": {"$ref": "#/$defs/model_run_usage_recorded"}
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "run_status_changed"}}, "required": ["event_type"]},
      "then": {
        "properties": {
          "actor_kind": {"const": "system"},
          "safe_payload": {"$ref": "#/$defs/run_status_changed"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "nullable_count": {
      "oneOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]
    },
    "run_started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "request_sha256", "dataset_sha256"],
      "properties": {
        "mode": {"const": "provider_completion_external_closure"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_sha256": {"type": "null"}
      }
    },
    "model_call_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_call_id",
        "provider",
        "model",
        "latency_ms",
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "cost_usd",
        "outcome",
        "error_code"
      ],
      "properties": {
        "model_call_id": {"type": "string", "pattern": "^MODEL-[A-F0-9]{16}$"},
        "provider": {"const": "deepseek"},
        "model": {"const": "deepseek-v4-flash"},
        "latency_ms": {"type": "number", "minimum": 0, "maximum": 600000},
        "input_tokens": {"$ref": "#/$defs/nullable_count"},
        "output_tokens": {"$ref": "#/$defs/nullable_count"},
        "cached_tokens": {"$ref": "#/$defs/nullable_count"},
        "cost_usd": {"type": "null"},
        "outcome": {"enum": ["succeeded", "failed"]},
        "error_code": {
          "oneOf": [{"type": "string", "pattern": "^[a-z0-9_]{1,96}$"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "succeeded"}}, "required": ["outcome"]},
          "then": {"properties": {"error_code": {"type": "null"}}},
          "else": {"properties": {"error_code": {"type": "string", "pattern": "^[a-z0-9_]{1,96}$"}}}
        }
      ]
    },
    "model_run_usage_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_complete",
        "request_count",
        "input_unit_count",
        "output_unit_count",
        "total_unit_count",
        "cached_input_unit_count",
        "response_detail_count",
        "estimated_cost_usd",
        "model_call_rows_recorded",
        "latency_allocation",
        "model_call_cost_method",
        "provider",
        "transport"
      ],
      "properties": {
        "usage_complete": {"type": "boolean"},
        "request_count": {"$ref": "#/$defs/nullable_count"},
        "input_unit_count": {"$ref": "#/$defs/nullable_count"},
        "output_unit_count": {"$ref": "#/$defs/nullable_count"},
        "total_unit_count": {"$ref": "#/$defs/nullable_count"},
        "cached_input_unit_count": {"$ref": "#/$defs/nullable_count"},
        "response_detail_count": {"type": "integer", "minimum": 0, "maximum": 800},
        "estimated_cost_usd": {"type": "null"},
        "model_call_rows_recorded": {"type": "integer", "minimum": 0, "maximum": 800},
        "latency_allocation": {"const": "equal_share_of_agent_segment"},
        "model_call_cost_method": {"const": "cny_recomputed_only_in_closure"},
        "provider": {"const": "deepseek"},
        "transport": {"const": "openai_compatible_responses"}
      },
      "allOf": [
        {
          "if": {"properties": {"usage_complete": {"const": true}}, "required": ["usage_complete"]},
          "then": {
            "properties": {
              "request_count": {"type": "integer", "minimum": 1, "maximum": 800},
              "input_unit_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "output_unit_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "total_unit_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "cached_input_unit_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
            }
          }
        }
      ]
    },
    "run_status_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "error_code"],
      "properties": {
        "from": {"const": "running"},
        "to": {"enum": ["completed", "failed", "cancelled"]},
        "error_code": {
          "oneOf": [{"type": "string", "pattern": "^[a-z0-9_]{1,96}$"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"to": {"const": "completed"}}, "required": ["to"]},
          "then": {"properties": {"error_code": {"type": "null"}}},
          "else": {"properties": {"error_code": {"type": "string", "pattern": "^[a-z0-9_]{1,96}$"}}}
        }
      ]
    }
  }
}
