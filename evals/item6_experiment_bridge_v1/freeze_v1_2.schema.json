{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "mode",
    "execution_commit",
    "execution_tree",
    "source_commitment_sha256",
    "source_manifest_sha256",
    "workflow_sha256",
    "scorer_commit",
    "tasks_sha256",
    "evidence_sha256",
    "scoring_contract_sha256",
    "environment_id",
    "policy",
    "budget",
    "pricing",
    "business_plan",
    "model_case_ids",
    "model_case_handles",
    "case_rejection_policy_revision",
    "case_rejection_policy_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "item6-experiment-freeze/1.2"
    },
    "scope": {
      "const": "item6_controlled_experiment_v1"
    },
    "mode": {
      "enum": [
        "offline_test",
        "live"
      ]
    },
    "execution_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "execution_tree": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflow_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        ".github/workflows/ci.yml",
        ".github/workflows/item6-experiment-bridge-offline.yml"
      ],
      "properties": {
        ".github/workflows/ci.yml": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        ".github/workflows/item6-experiment-bridge-offline.yml": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scorer_commit": {
      "const": "fcc2026c60943de6016495ad244291689a9d491d"
    },
    "tasks_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scoring_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^PCEENV-[A-F0-9]{32}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "model",
        "origin",
        "request_bytes",
        "response_bytes",
        "business_field_bytes",
        "archive_bytes",
        "limits",
        "tools",
        "instruction_sha256",
        "reasoning_effort",
        "http_retries",
        "sdk_retries",
        "follow_redirects",
        "trust_env",
        "online_authorized",
        "live_budget_default",
        "runtime_freeze_directory",
        "workflows_separately_git_bound"
      ],
      "properties": {
        "schema_version": {
          "const": "item6-experiment-policy/1.0"
        },
        "model": {
          "const": "deepseek-flash"
        },
        "origin": {
          "const": "https://api.deepseek.com"
        },
        "request_bytes": {
          "const": 32768
        },
        "response_bytes": {
          "const": 100000
        },
        "business_field_bytes": {
          "const": 131072
        },
        "archive_bytes": {
          "const": 8388608
        },
        "limits": {
          "const": {
            "requests_per_task": 3,
            "model_requests": 48,
            "input_per_request": 6000,
            "output_per_request": 1000,
            "input_total": 288000,
            "output_total": 48000,
            "request_bytes": 32768,
            "tools_per_task": 2,
            "tool_total": 64,
            "request_seconds": 30,
            "tool_seconds": 5,
            "task_seconds": 120,
            "batch_seconds": 2700
          }
        },
        "tools": {
          "const": [
            {
              "type": "function",
              "name": "inspect_sources",
              "description": "Read metadata in the authorized synthetic scope.",
              "strict": true,
              "parameters": {
                "type": "object",
                "title": "inspect_sources_args",
                "properties": {
                  "scope_id": {
                    "type": "string",
                    "title": "Scope Id"
                  }
                },
                "required": [
                  "scope_id"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "function",
              "name": "read_aggregate",
              "description": "Read the requested authorized aggregate result.",
              "strict": true,
              "parameters": {
                "type": "object",
                "title": "read_aggregate_args",
                "properties": {
                  "bundle_id": {
                    "type": "string",
                    "title": "Bundle Id"
                  }
                },
                "required": [
                  "bundle_id"
                ],
                "additionalProperties": false
              }
            }
          ]
        },
        "instruction_sha256": {
          "const": "9dd3b2fb721a60d22c29640a1a25e00ca6825f83c3b809cd4d0d7acdd2cd1f11"
        },
        "reasoning_effort": {
          "const": "none"
        },
        "http_retries": {
          "const": 0
        },
        "sdk_retries": {
          "const": 0
        },
        "follow_redirects": {
          "const": false
        },
        "trust_env": {
          "const": false
        },
        "online_authorized": {
          "const": false
        },
        "live_budget_default": {
          "const": null
        },
        "runtime_freeze_directory": {
          "const": "output/item6-experiment-bridge-v1"
        },
        "workflows_separately_git_bound": {
          "const": [
            ".github/workflows/ci.yml",
            ".github/workflows/item6-experiment-bridge-offline.yml"
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_task",
        "model_requests",
        "input_per_request",
        "output_per_request",
        "input_total",
        "output_total",
        "request_bytes",
        "tools_per_task",
        "tool_total",
        "request_seconds",
        "tool_seconds",
        "task_seconds",
        "batch_seconds"
      ],
      "properties": {
        "requests_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "model_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "input_per_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "output_per_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "input_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 288000
        },
        "output_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48000
        },
        "request_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "tools_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "tool_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "request_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "tool_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "task_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "batch_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2700
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "input_per_million",
        "output_per_million",
        "cost_limit",
        "input_accounting",
        "provider_bill_hard_cap",
        "evidence_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "synthetic_fixture",
            "user_reviewed_official_snapshot"
          ]
        },
        "input_per_million": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "output_per_million": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cost_limit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_accounting": {
          "enum": [
            "synthetic_bytes",
            "observed_stop"
          ]
        },
        "provider_bill_hard_cap": {
          "const": false
        },
        "evidence_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "business_plan": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "path_kind"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path_kind": {
            "enum": [
              "agent",
              "fixed_workflow"
            ]
          }
        }
      }
    },
    "model_case_ids": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "model_case_handles": {
      "type": "object",
      "minProperties": 16,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^IC-[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^PCECASE-[A-F0-9]{32}$"
      }
    },
    "case_rejection_policy_revision": {
      "const": "item6-case-rejection-isolation/1.1"
    },
    "case_rejection_policy_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
