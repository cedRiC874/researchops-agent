{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/eval-v2/private/signed-ledger-v1.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "synthetic", "ledger_id",
    "trust_manifest_sha256", "base_sequence", "base_head_sha256", "entries",
    "head_sequence", "ledger_head_sha256", "signed_at_utc", "document_sha256", "signatures"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "document_type": {"const": "signed_ledger"},
    "synthetic": {"type": "boolean"},
    "ledger_id": {"type": "string", "pattern": "^LEDGER-[A-F0-9]{16}$"},
    "trust_manifest_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "base_sequence": {"type": "integer", "minimum": 0},
    "base_head_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {
      "type": "array", "minItems": 2, "maxItems": 100000,
      "items": {"oneOf": [
        {"$ref": "#/$defs/access_reserved"},
        {"$ref": "#/$defs/resume_authorized"},
        {"$ref": "#/$defs/terminal"}
      ]}
    },
    "head_sequence": {"type": "integer", "minimum": 2},
    "ledger_head_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "signed_at_utc": {"$ref": "#/$defs/timestamp"},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "signatures": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/custodian_signature"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzero_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "entry_signature": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "key_id", "algorithm", "signed_sha256", "signature_b64"],
      "properties": {
        "role": {"enum": ["freeze_authority", "custodian"]},
        "key_id": {"type": "string", "pattern": "^KEY-[A-F0-9]{16}$"},
        "algorithm": {"const": "ed25519"},
        "signed_sha256": {"$ref": "#/$defs/sha256"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "custodian_signature": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "key_id", "algorithm", "signed_sha256", "signature_b64"],
      "properties": {
        "role": {"const": "custodian"},
        "key_id": {"type": "string", "pattern": "^KEY-[A-F0-9]{16}$"},
        "algorithm": {"const": "ed25519"},
        "signed_sha256": {"$ref": "#/$defs/sha256"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "access_reserved": {
      "type": "object", "additionalProperties": false,
      "required": [
        "event_type", "synthetic", "sequence", "previous_entry_sha256", "event_at_utc",
        "freeze_request_sha256", "candidate_commitment_sha256",
        "salted_corpus_commitment_sha256", "authorization_grant_sha256",
        "authorization_nonce_sha256", "run_commitment_sha256",
        "provider_plan_sha256", "budget_policy_sha256", "retention_policy_sha256",
        "entry_sha256", "signatures"
      ],
      "properties": {
        "event_type": {"const": "access_reserved"},
        "synthetic": {"type": "boolean"},
        "sequence": {"type": "integer", "minimum": 1},
        "previous_entry_sha256": {"$ref": "#/$defs/sha256"},
        "event_at_utc": {"$ref": "#/$defs/timestamp"},
        "freeze_request_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "candidate_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "salted_corpus_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "authorization_grant_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "authorization_nonce_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "run_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "provider_plan_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "budget_policy_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "retention_policy_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "signatures": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/entry_signature"}}
      }
    },
    "resume_authorized": {
      "type": "object", "additionalProperties": false,
      "required": [
        "event_type", "synthetic", "sequence", "previous_entry_sha256", "event_at_utc",
        "freeze_request_sha256", "candidate_commitment_sha256",
        "salted_corpus_commitment_sha256", "authorization_grant_sha256",
        "authorization_nonce_sha256", "run_commitment_sha256",
        "provider_plan_sha256", "budget_policy_sha256", "retention_policy_sha256",
        "reservation_entry_sha256", "resume_ordinal", "checkpoint_commitment_sha256",
        "entry_sha256", "signatures"
      ],
      "properties": {
        "event_type": {"const": "resume_authorized"},
        "synthetic": {"type": "boolean"},
        "sequence": {"type": "integer", "minimum": 2},
        "previous_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "event_at_utc": {"$ref": "#/$defs/timestamp"},
        "freeze_request_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "candidate_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "salted_corpus_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "authorization_grant_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "authorization_nonce_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "run_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "provider_plan_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "budget_policy_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "retention_policy_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "reservation_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "resume_ordinal": {"type": "integer", "minimum": 1, "maximum": 10},
        "checkpoint_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "signatures": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/entry_signature"}}
      }
    },
    "terminal": {
      "type": "object", "additionalProperties": false,
      "required": [
        "event_type", "synthetic", "sequence", "previous_entry_sha256", "event_at_utc",
        "freeze_request_sha256", "candidate_commitment_sha256",
        "salted_corpus_commitment_sha256", "authorization_grant_sha256",
        "authorization_nonce_sha256", "run_commitment_sha256",
        "provider_plan_sha256", "budget_policy_sha256", "retention_policy_sha256",
        "reservation_entry_sha256", "terminal_status", "aggregate_results_sha256",
        "completed_total_case_executions", "entry_sha256", "signatures"
      ],
      "properties": {
        "event_type": {"const": "terminal"},
        "synthetic": {"type": "boolean"},
        "sequence": {"type": "integer", "minimum": 2},
        "previous_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "event_at_utc": {"$ref": "#/$defs/timestamp"},
        "freeze_request_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "candidate_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "salted_corpus_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "authorization_grant_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "authorization_nonce_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "run_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "provider_plan_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "budget_policy_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "retention_policy_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "reservation_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "terminal_status": {"enum": ["complete", "stopped", "aborted"]},
        "aggregate_results_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "completed_total_case_executions": {"type": "integer", "minimum": 0},
        "entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "signatures": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/entry_signature"}}
      }
    }
  }
}
