{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/eval-v2/private/release-manifest-v1.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "synthetic", "release_id", "released_at_utc",
    "trust_manifest_sha256", "freeze_request_sha256", "commitment_statement_sha256",
    "authorization_grant_sha256", "aggregate_results_sha256",
    "consumption_receipt_sha256", "signed_ledger_sha256",
    "anchored_trust_manifest_sha256", "anchored_freeze_request_sha256",
    "anchored_candidate_commitment_sha256", "anchored_ledger_base_head_sha256",
    "anchored_access_reservation_entry_sha256", "anchored_ledger_final_head_sha256",
    "anchored_ledger_final_sequence", "verification_scope", "release_status",
    "retention_gate_status", "private_content_included", "task_ids_included",
    "locators_included", "per_case_results_included", "raw_provider_content_included",
    "private_holdout_claim_allowed", "model_quality_claim_allowed",
    "unknown_distribution_generalization_claim_allowed", "production_sla_claim_allowed",
    "document_sha256", "signatures"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "document_type": {"const": "release_manifest"},
    "synthetic": {"type": "boolean"},
    "release_id": {"type": "string", "pattern": "^PRL-[A-F0-9]{16}$"},
    "released_at_utc": {"$ref": "#/$defs/timestamp"},
    "trust_manifest_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "freeze_request_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "commitment_statement_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "authorization_grant_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "aggregate_results_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "consumption_receipt_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "signed_ledger_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "anchored_trust_manifest_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "anchored_freeze_request_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "anchored_candidate_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "anchored_ledger_base_head_sha256": {"$ref": "#/$defs/sha256"},
    "anchored_access_reservation_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "anchored_ledger_final_head_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "anchored_ledger_final_sequence": {"type": "integer", "minimum": 2},
    "verification_scope": {"const": "integrity_and_supplied_external_anchors_only"},
    "release_status": {"enum": ["verified_aggregate_only", "stopped_aggregate_only", "aborted_aggregate_only"]},
    "retention_gate_status": {"enum": ["verified", "synthetic_not_applicable"]},
    "private_content_included": {"const": false},
    "task_ids_included": {"const": false},
    "locators_included": {"const": false},
    "per_case_results_included": {"const": false},
    "raw_provider_content_included": {"const": false},
    "private_holdout_claim_allowed": {"const": false},
    "model_quality_claim_allowed": {"const": false},
    "unknown_distribution_generalization_claim_allowed": {"const": false},
    "production_sla_claim_allowed": {"const": false},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "signatures": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzero_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "key_id", "algorithm", "signed_sha256", "signature_b64"],
      "properties": {
        "role": {"const": "custodian"},
        "key_id": {"type": "string", "pattern": "^KEY-[A-F0-9]{16}$"},
        "algorithm": {"const": "ed25519"},
        "signed_sha256": {"$ref": "#/$defs/sha256"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
