{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/eval-v2/private/authorization-grant-v1.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "synthetic", "authorization_id",
    "authorized_at_utc", "not_before_utc", "expires_at_utc", "freeze_request_sha256",
    "commitment_statement_sha256", "candidate_commitment_sha256",
    "salted_corpus_commitment_sha256", "authorization_nonce_sha256",
    "run_commitment_sha256", "provider_plan", "private_case_count",
    "repetitions_per_provider", "single_use", "maximum_campaigns",
    "ledger_id", "ledger_base_sequence", "ledger_base_head_sha256",
    "access_reservation_required", "small_cell_threshold", "budget_policy", "retention_policy",
    "private_access_scope", "private_content_transfer_to_project", "resume_policy",
    "maximum_resume_count", "status", "private_access_authorized",
    "model_quality_claim_allowed", "document_sha256", "signatures"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "document_type": {"const": "authorization_grant"},
    "synthetic": {"type": "boolean"},
    "authorization_id": {"type": "string", "pattern": "^PAG-[A-F0-9]{16}$"},
    "authorized_at_utc": {"$ref": "#/$defs/timestamp"},
    "not_before_utc": {"$ref": "#/$defs/timestamp"},
    "expires_at_utc": {"$ref": "#/$defs/timestamp"},
    "freeze_request_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "commitment_statement_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "candidate_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "salted_corpus_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "authorization_nonce_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "run_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "provider_plan": {
      "type": "array", "minItems": 2, "maxItems": 8,
      "items": {"$ref": "#/$defs/provider"}
    },
    "private_case_count": {"type": "integer", "minimum": 50, "maximum": 10000},
    "repetitions_per_provider": {"const": 3},
    "single_use": {"const": true},
    "maximum_campaigns": {"const": 1},
    "ledger_id": {"type": "string", "pattern": "^LEDGER-[A-F0-9]{16}$"},
    "ledger_base_sequence": {"type": "integer", "minimum": 0},
    "ledger_base_head_sha256": {"$ref": "#/$defs/sha256"},
    "access_reservation_required": {"const": true},
    "small_cell_threshold": {"type": "integer", "minimum": 5, "maximum": 100},
    "budget_policy": {"$ref": "#/$defs/budget_policy"},
    "retention_policy": {"$ref": "#/$defs/retention_policy"},
    "private_access_scope": {"const": "custodian_environment_only"},
    "private_content_transfer_to_project": {"const": false},
    "resume_policy": {"const": "dual_signed_same_run_and_identical_commitments_only"},
    "maximum_resume_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "status": {"const": "authorized"},
    "private_access_authorized": {"const": true},
    "model_quality_claim_allowed": {"const": false},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "signatures": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzero_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,8})\\.[0-9]{6}$"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "model_id", "transport_id", "config_sha256"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
        "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "transport_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "config_sha256": {"$ref": "#/$defs/nonzero_sha256"}
      }
    },
    "budget_policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "currency", "pricing_commitment_sha256", "maximum_model_calls",
        "maximum_input_tokens", "maximum_output_tokens", "maximum_cost_decimal",
        "complete_usage_required_for_complete_status"
      ],
      "properties": {
        "currency": {"const": "USD"},
        "pricing_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
        "maximum_model_calls": {"type": "integer", "minimum": 1},
        "maximum_input_tokens": {"type": "integer", "minimum": 1},
        "maximum_output_tokens": {"type": "integer", "minimum": 1},
        "maximum_cost_decimal": {"$ref": "#/$defs/money"},
        "complete_usage_required_for_complete_status": {"const": true}
      }
    },
    "retention_policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pilot_participant_derived_data_allowed", "direct_or_quasi_identifier_data_allowed",
        "maximum_plaintext_retention_hours", "provider_log_attestation_required",
        "proxy_log_attestation_required", "backup_attestation_required"
      ],
      "properties": {
        "pilot_participant_derived_data_allowed": {"const": false},
        "direct_or_quasi_identifier_data_allowed": {"const": false},
        "maximum_plaintext_retention_hours": {"type": "integer", "minimum": 1, "maximum": 72},
        "provider_log_attestation_required": {"const": true},
        "proxy_log_attestation_required": {"const": true},
        "backup_attestation_required": {"const": true}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "key_id", "algorithm", "signed_sha256", "signature_b64"],
      "properties": {
        "role": {"enum": ["freeze_authority", "custodian"]},
        "key_id": {"type": "string", "pattern": "^KEY-[A-F0-9]{16}$"},
        "algorithm": {"const": "ed25519"},
        "signed_sha256": {"$ref": "#/$defs/sha256"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
