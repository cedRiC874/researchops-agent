{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchops.local/schemas/eval-v2/private/consumption-receipt-v1.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "synthetic", "receipt_id", "run_id",
    "access_reserved_at_utc", "completed_at_utc", "receipt_created_at_utc", "terminal_status",
    "authorization_grant_sha256", "freeze_request_sha256", "commitment_statement_sha256",
    "aggregate_results_sha256", "signed_ledger_sha256", "candidate_commitment_sha256",
    "salted_corpus_commitment_sha256", "run_commitment_sha256", "ledger_id",
    "ledger_base_sequence", "ledger_base_head_sha256", "ledger_final_sequence",
    "ledger_final_head_sha256", "access_reservation_entry_sha256",
    "terminal_entry_sha256", "authorization_consumed", "submission_ordinal",
    "rerun_performed", "resume_count", "resume_commitments_unchanged",
    "ambiguous_inflight_replayed", "private_content_transferred_to_project",
    "pilot_participant_derived_data_present", "direct_or_quasi_identifier_data_present",
    "human_subject_data_classification", "private_plaintext_disposition",
    "private_plaintext_deleted_at_utc", "provider_log_attestation_status",
    "proxy_log_attestation_status", "backup_attestation_status", "retention_gate_status",
    "result_release_policy", "model_quality_claim_allowed", "document_sha256", "signatures"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "document_type": {"const": "consumption_receipt"},
    "synthetic": {"type": "boolean"},
    "receipt_id": {"type": "string", "pattern": "^PCR-[A-F0-9]{16}$"},
    "run_id": {"type": "string", "pattern": "^PRUN-[A-F0-9]{16}$"},
    "access_reserved_at_utc": {"$ref": "#/$defs/timestamp"},
    "completed_at_utc": {"$ref": "#/$defs/timestamp"},
    "receipt_created_at_utc": {"$ref": "#/$defs/timestamp"},
    "terminal_status": {"enum": ["complete", "stopped", "aborted"]},
    "authorization_grant_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "freeze_request_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "commitment_statement_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "aggregate_results_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "signed_ledger_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "candidate_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "salted_corpus_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "run_commitment_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "ledger_id": {"type": "string", "pattern": "^LEDGER-[A-F0-9]{16}$"},
    "ledger_base_sequence": {"type": "integer", "minimum": 0},
    "ledger_base_head_sha256": {"$ref": "#/$defs/sha256"},
    "ledger_final_sequence": {"type": "integer", "minimum": 2},
    "ledger_final_head_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "access_reservation_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "terminal_entry_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "authorization_consumed": {"const": true},
    "submission_ordinal": {"const": 1},
    "rerun_performed": {"const": false},
    "resume_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "resume_commitments_unchanged": {"const": true},
    "ambiguous_inflight_replayed": {"const": false},
    "private_content_transferred_to_project": {"const": false},
    "pilot_participant_derived_data_present": {"const": false},
    "direct_or_quasi_identifier_data_present": {"const": false},
    "human_subject_data_classification": {"enum": ["none", "public_deidentified"]},
    "private_plaintext_disposition": {"const": "deleted"},
    "private_plaintext_deleted_at_utc": {"$ref": "#/$defs/timestamp"},
    "provider_log_attestation_status": {"enum": ["verified", "synthetic_not_applicable"]},
    "proxy_log_attestation_status": {"enum": ["verified", "synthetic_not_applicable"]},
    "backup_attestation_status": {"enum": ["verified", "synthetic_not_applicable"]},
    "retention_gate_status": {"enum": ["verified", "synthetic_not_applicable"]},
    "result_release_policy": {"const": "signed_sanitized_aggregate_only"},
    "model_quality_claim_allowed": {"const": false},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "signatures": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzero_sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "key_id", "algorithm", "signed_sha256", "signature_b64"],
      "properties": {
        "role": {"const": "custodian"},
        "key_id": {"type": "string", "pattern": "^KEY-[A-F0-9]{16}$"},
        "algorithm": {"const": "ed25519"},
        "signed_sha256": {"$ref": "#/$defs/sha256"},
        "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
