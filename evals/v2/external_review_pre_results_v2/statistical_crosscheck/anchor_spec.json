      "effect_size": "cohen_d_pooled_sd_and_hedges_g_exact_gamma_correction",
      "pooled_standard_deviation_formula": "sqrt(((control_n - 1) * control_sample_sd^2 + (treatment_n - 1) * treatment_sample_sd^2) / (control_n + treatment_n - 2))",
