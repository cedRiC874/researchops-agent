  "limits": {"packet_bytes": 33554432, "public_document_bytes": 2000000, "public_document_bytes_total": 33554432, "timing_plan_bytes": 131072, "path_characters": 4096, "contract_bytes": 32768, "summary_bytes": 8192},
  "execution_order": [
    "without_exact_confirmation_return_not_confirmed_without_invocation_input_contract_task_key_or_store_reads",
    "load_and_hash_check_this_contract_and_bound_public_input_sizes",
    "verify_signed_prerequisites_current_source_environment_expiry_and_win_fixed_store_claim",
    "read_private_task_package_once_through_existing_consumed_task_owner",
    "derive_fixed_paths_from_verified_authorization_id_sha256_and_hold_work_database_and_ancestors",
    "create_actual_campaign_factory_and_run_owned_key_phase_with_existing_per_send_gates",
    "on_success_use_existing_seven_file_publisher_with_one_sealing_budget",
    "write_pre_return_archive_verified_summary_exclusively_inside_same_sealing_budget",
    "release_work_database_and_directory_handles_and_check_same_sealing_and_authorization_deadlines",
    "only_then_return_completed_summary_to_api_or_stdout_without_rewriting_disk_snapshot"
  ],
  "fixed_paths": {
    "parent": "output/campaign-v1",
    "work_database": "output/campaign-v1/<authorization_id_sha256>.work/phase6_audit.sqlite3",
    "archive": "output/campaign-v1/<authorization_id_sha256>",
    "pre_return_summary": "output/campaign-v1/<authorization_id_sha256>.invocation.json",
    "existing_work_archive_or_summary_forbids_resume": true
  },
  "failure_rules": [
    "no_provider_retry_resume_fallback_or_claim_release",
    "retain_existing_and_partial_files_without_overwrite_or_deletion",
    "failure_stdout_is_local_diagnostic_not_a_new_partial_or_quarantine_archive_format",
    "no_post_failure_success_summary_write_or_successor_regeneration",
    "absent_factory_counts_are_null_not_inferred_zero",
    "claim_consumed_is_null_when_preparation_failure_does_not_prove_consumption_or_nonconsumption",
    "after_a_failed_final_close_or_deadline_check_do_not_return_completed_even_if_seven_files_exist",
    "do_not_emit_failed_artifact_hashes_or_paths_as_success_evidence",
    "exception_body_traceback_key_task_input_model_output_and_absolute_paths_are_not_diagnostics",
    "a_pre_return_disk_snapshot_does_not_claim_its_own_write_or_final_workspace_close_succeeded",
    "stdout_and_disk_persistence_are_not_guaranteed_after_process_death_or_io_failure",
    "publisher_created_file_names_are_internal_diagnostics_not_external_closure_evidence"
