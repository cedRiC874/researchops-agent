  "cross_field_rules": [
    "archive_relative_path_when_present_equals_fixed_parent_plus_authorization_id_sha256",
    "only_pre_return_archive_verified_and_completed_may_have_archive_hash_or_path",
    "verified_archive_requires_claim_consumed_true_phase_completed_true_nonzero_run_and_dispatch_counts",
    "pre_return_archive_verified_has_final_workspace_close_observed_false_and_receipt_write_status_excluded_self_write",
    "completed_has_final_workspace_close_observed_true_and_receipt_write_status_completed",
    "not_confirmed_has_no_authorization_id_no_phase_or_archive_observation_null_counts_and_claim_consumed_false",
    "failed_or_unknown_summaries_must_have_a_non_null_fixed_error_code",
    "known_dispatch_count_cannot_be_less_than_known_completed_run_count_in_verified_archive_summaries"
  ],
  "summary_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "status", "observation_scope", "authorization_id_sha256", "claim_consumed", "phase_completed", "archive_status", "final_workspace_close_observed", "run_count", "native_dispatch_count", "archive_relative_path", "manifest_file_sha256", "receipt_write_status", "error_code", "retry_authorized", "closure_claim_allowed", "runtime_authority_granted", "provider_bill_cny", "provider_calls_independently_verified"],
    "properties": {
      "schema_version": {"const": "provider-completion-campaign-invocation/1.0"},
      "status": {"enum": ["not_confirmed", "pre_return_archive_verified", "completed", "failed", "outcome_unknown"]},
      "observation_scope": {"const": "local_invocation_only"},
      "authorization_id_sha256": {"anyOf": [{"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$", "minLength": 64, "maxLength": 64}, {"type": "null"}]},
      "claim_consumed": {"type": ["boolean", "null"]},
      "phase_completed": {"type": ["boolean", "null"]},
      "archive_status": {"enum": ["not_attempted", "verified", "incomplete", "unknown"]},
      "final_workspace_close_observed": {"type": ["boolean", "null"]},
      "run_count": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 100}, {"type": "null"}]},
      "native_dispatch_count": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 800}, {"type": "null"}]},
      "archive_relative_path": {"anyOf": [{"type": "string", "pattern": "^output/campaign-v1/(?!0{64}$)[0-9a-f]{64}$", "minLength": 83, "maxLength": 83}, {"type": "null"}]},
      "manifest_file_sha256": {"anyOf": [{"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$", "minLength": 64, "maxLength": 64}, {"type": "null"}]},
      "receipt_write_status": {"enum": ["not_attempted", "excluded_self_write", "completed", "incomplete", "unknown"]},
      "error_code": {"enum": [null, "campaign_invocation_not_confirmed", "campaign_invocation_inputs_invalid", "campaign_invocation_admission_failed", "campaign_invocation_task_opening_failed", "campaign_invocation_workspace_failed", "campaign_invocation_phase_failed", "campaign_invocation_publication_failed", "campaign_invocation_finalization_failed", "campaign_invocation_unknown"]},
      "retry_authorized": {"const": false},
      "closure_claim_allowed": {"const": false},
      "runtime_authority_granted": {"const": false},
      "provider_bill_cny": {"type": "null"},
      "provider_calls_independently_verified": {"const": false}
    },
    "allOf": [
      {"if": {"properties": {"status": {"enum": ["pre_return_archive_verified", "completed"]}}}, "then": {"properties": {"authorization_id_sha256": {"type": "string"}, "claim_consumed": {"const": true}, "phase_completed": {"const": true}, "archive_status": {"const": "verified"}, "run_count": {"type": "integer", "minimum": 1}, "native_dispatch_count": {"type": "integer", "minimum": 1}, "archive_relative_path": {"type": "string"}, "manifest_file_sha256": {"type": "string"}, "error_code": {"type": "null"}}}, "else": {"properties": {"archive_status": {"enum": ["not_attempted", "incomplete", "unknown"]}, "archive_relative_path": {"type": "null"}, "manifest_file_sha256": {"type": "null"}, "error_code": {"type": "string"}}}},
      {"if": {"properties": {"status": {"const": "pre_return_archive_verified"}}}, "then": {"properties": {"final_workspace_close_observed": {"const": false}, "receipt_write_status": {"const": "excluded_self_write"}}}},
      {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"final_workspace_close_observed": {"const": true}, "receipt_write_status": {"const": "completed"}}}},
      {"if": {"properties": {"status": {"const": "not_confirmed"}}}, "then": {"properties": {"authorization_id_sha256": {"type": "null"}, "claim_consumed": {"const": false}, "phase_completed": {"type": "null"}, "archive_status": {"const": "not_attempted"}, "final_workspace_close_observed": {"type": "null"}, "run_count": {"type": "null"}, "native_dispatch_count": {"type": "null"}, "receipt_write_status": {"const": "not_attempted"}, "error_code": {"const": "campaign_invocation_not_confirmed"}}}}
    ]
  },
  "runtime_entry_implemented_by_this_contract": false,
  "online_execution_authorized": false,
  "provider_key_use_authorized": false,
  "historical_backfill_authorized": false,
