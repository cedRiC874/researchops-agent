    "confirm_online_default": false,
    "only_exact_true_confirms": true,
    "root_key_loader_transport_clock_claim_store_overrides_allowed": false,
    "return_type": "canonical_utf8_json_bytes"
  },
  "cli": {
    "module": "researchops_completion_timing.campaign_run",
    "flags": ["--packet", "--confirm-online"],
    "packet_schema_version": "provider-completion-campaign-invocation-input/1.0",
    "packet_fields": ["schema_version", "documents", "external_observation_bundle", "timing_plan", "admission", "task_package_path"],
    "document_fields": ["trust_manifest", "candidate_freeze_receipt", "candidate_frozen_ledger_entry", "seen_case_exclusion_manifest", "preregistration_envelope", "preregistration_frozen_ledger_entry", "authorization_grant", "consumption_receipt", "authorization_consumed_ledger_entry"],
    "admission_fields": ["artifact_directory", "bundle_bytes", "review_bytes", "trust_bytes", "observation_bytes", "expected_review_document_sha256", "expected_trust_manifest_sha256", "expected_authorization_binding_sha256", "expected_candidate_freeze_receipt_sha256", "expected_candidate_frozen_at_utc", "expected_first_live_completed_at_utc", "verification_time_utc"],
    "admission_utf8_document_fields": ["bundle_bytes", "review_bytes", "trust_bytes", "observation_bytes"],
    "embedded_document_representation": "utf8_json_text_not_base64_or_parsed_object",
