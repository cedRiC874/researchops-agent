!artifacts/eval_v2_public_regression/
artifacts/eval_v2_public_regression/*
!artifacts/eval_v2_public_regression/7744770aa4a36c131476b95d6ed9be248cdefc3ab0f4f2a18d5111b85c9f0d11.receipt.json
