__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.matplotlib/
tmp/

# Local rendered documents and email drafts. EML files may contain user email
# addresses and must never enter source control.
output/

# Eval v2 private holdout material must remain with an external custodian.
# These patterns are defense in depth; the campaign contract also rejects
# repository-local private content, goldens, identifiers, and locators.
evals/v2/private/
evals/v2/custody/
evals/v2/external/

# Runtime outputs are ignored by default. Curated, aggregate-only portfolio
# evidence is explicitly allowlisted below; SQLite ledgers and row-like JSONL
# outputs are never committed.
artifacts/*
!artifacts/.gitkeep
!artifacts/profile.json
!artifacts/method_recommendation.json

!artifacts/phase3/
artifacts/phase3/*
!artifacts/phase3/analysis_bundle.json
!artifacts/phase3/effect_estimates.png

