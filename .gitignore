!artifacts/phase4/releases/
artifacts/phase4/releases/*
!artifacts/phase4/releases/demo-release/
artifacts/phase4/releases/demo-release/*
!artifacts/phase4/releases/demo-release/release_manifest.json

!artifacts/portfolio_baseline/
artifacts/portfolio_baseline/*
!artifacts/portfolio_baseline/eval_manifest.json
!artifacts/portfolio_baseline/eval_report.json
!artifacts/portfolio_baseline/eval_summary.md
!artifacts/portfolio_baseline/eval_audit_index.json

!artifacts/portfolio_baseline_provider/
artifacts/portfolio_baseline_provider/*
!artifacts/portfolio_baseline_provider/eval_manifest.json
!artifacts/portfolio_baseline_provider/eval_report.json
!artifacts/portfolio_baseline_provider/eval_summary.md
