__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.matplotlib/

# Runtime outputs are ignored by default. Curated, aggregate-only portfolio
# evidence is explicitly allowlisted below; SQLite ledgers and row-like JSONL
# outputs are never committed.
